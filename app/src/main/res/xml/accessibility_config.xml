<?xml version="1.0" encoding="utf-8"?>
<!--
  Window-change events only; no key events, no touch exploration. canRetrieveWindowContent is required by Android to
  list windows (to see whether the status bar is showing); the app only reads window type, geometry and the owner's
  package name. canPerformGestures is used for one thing: swiping away the system's own pop-up of a notification the
  island already took over, so it does not show twice.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="150"
    android:settingsActivity="dev.igun997.fluteisland.MainActivity" />
